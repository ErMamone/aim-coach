{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2017",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "strict": false,
    "skipLibCheck": true,
    "lib": ["es2017", "dom"],
    "types": ["@overwolf/types"]
  },
  "exclude": ["node_modules", "dist"]
}
