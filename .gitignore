# Dependencias
node_modules/

# Yarn Berry (PnP) — no zero-install: se regenera con `yarn install`
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# Build output
dist/
build/

# Empaquetado OPK (se regenera con `yarn package`)
release/
.opk-stage/
*.opk

# Salida de tests / demos compilados (tsc -> node) + cobertura
.tmp-tests/
.tmp/
coverage/
.nyc_output/

# Nativo (.NET) — artefactos de compilación (se rebuildean con `dotnet publish`).
# El single-file self-contained (~11MB, Win32 crudo + trimmed) no se versiona: se regenera desde
# native/MouseCapturer.cs (ver docs).
native/obj/
native/bin/
native/publish/

# IA / asistentes de código — no forman parte del producto (fuera del repo y del OPK)
.claude/
CLAUDE.md
AGENTS.md
.cursor/
.cursorrules
.aider*
.windsurfrules
.github/copilot-instructions.md

# Docs internos (se mantienen locales, no se publican)
docs/

# Logs / varios
*.log
.DS_Store
Thumbs.db
