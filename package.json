{
  "name": "aim-coach",
  "version": "0.1.0",
  "description": "Aim Coach — coach de aim para Valorant (Overwolf, ow-native)",
  "productName": "Aim Coach",
  "author": {
    "name": "Eros Mamone"
  },
  "license": "MIT",
  "scripts": {
    "build": "webpack",
    "watch": "webpack --watch",
    "build:native": "dotnet publish native/MouseCapturer.csproj -c Release -r win-x64 --self-contained -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -o native/publish",
    "build:all": "yarn build:native && yarn build",
    "test": "tsc -p tests/tsconfig.json && node .tmp-tests/tests/engine/run.js",
    "test:coverage": "tsc -p tests/tsconfig.json && c8 node .tmp-tests/tests/engine/run.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "yarn lint && yarn typecheck && yarn test:coverage && yarn build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@overwolf/types": "^3.23.1",
    "c8": "^11.0.0",
    "copy-webpack-plugin": "^11.0.0",
    "eslint": "^10.6.0",
    "html-webpack-plugin": "^5.5.0",
    "husky": "^9.1.7",
    "ts-loader": "^9.4.2",
    "typescript": "^4.9.5",
    "typescript-eslint": "^8.62.1",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1"
  },
  "packageManager": "yarn@4.17.0"
}
